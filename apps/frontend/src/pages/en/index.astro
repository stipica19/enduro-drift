---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/ui/Hero.astro";
import TopEnduroSection from "@/components/ui/TopEnduroSection.astro";
import GallerySlider from "@/components/ui/GallerySlider.astro";
import TourTeaserSection from "@/components/ui/TourTeaserSection.astro";
import LocationSection from "@/components/ui/LocationSection.astro";
import WhyChooseUsSection from "@/components/ui/WhyChooseUsSection.astro";
import AccommodationSection from "@/components/ui/AccommodationSection.astro";
import MotorcyclesSection from "@/components/ui/MotorcyclesSection.astro";
import TourRulesSection from "@/components/ui/TourRulesSection.astro";
import FaqSection from "@/components/ui/FaqSection.astro";
import LatestPosts from "@/components/ui/LatestPosts.astro";
import { faqSchema } from "@/lib/structuredData";
import { faq } from "@/content/site/faq";
import { toSliderImages } from "@/lib/sliderImages";

const galleryImages = toSliderImages(
  import.meta.glob<{ default: ImageMetadata }>(
    "../../assets/gallerySlider/*.{jpg,jpeg,png,webp}",
    { eager: true },
  ),
  "en",
);

const natureImages = toSliderImages(
  import.meta.glob<{ default: ImageMetadata }>(
    "../../assets/naturSlider/*.{jpg,jpeg,png,webp}",
    { eager: true },
  ),
  "en",
);
---

<Layout
  title="Enduro Holidays in Bosnia – Guided Tours | Enduro Drift"
  description="Enduro holidays in Bosnia and Herzegovina: guided tours around Gornji Vakuf for beginners to pros. Legal routes, small groups, rental motorcycles on site."
  path="/en"
  lang="en"
  alternates={{ de: "/de", en: "/en" }}
  schema={[faqSchema(faq.en.items)]}
>
  <Hero lang="en" />
  <TopEnduroSection lang="en" />
  <section class="defer-render bg-white py-16 lg:py-24">
    <GallerySlider images={galleryImages} />
  </section>
  <div class="defer-render"><TourTeaserSection lang="en" /></div>
  <div class="defer-render"><LocationSection lang="en" /></div>
  <div class="defer-render"><WhyChooseUsSection lang="en" /></div>
  <section class="defer-render bg-white py-16 lg:py-24">
    <GallerySlider images={natureImages} />
  </section>
  <div class="defer-render"><AccommodationSection lang="en" /></div>
  <div class="defer-render"><MotorcyclesSection lang="en" /></div>
  <div class="defer-render"><TourRulesSection lang="en" /></div>
  <div class="defer-render"><FaqSection lang="en" /></div>
  <div class="defer-render"><LatestPosts lang="en" /></div>
</Layout>
