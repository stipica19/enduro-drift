---
import Layout from "@/layouts/Layout.astro";
import TourDatesTable from "@/components/ui/TourDatesTable.astro";
import CtaButtons from "@/components/ui/CtaButtons.astro";
import { dates } from "@/content/site/dates";

const lang = "en" as const;
const t = dates[lang];
---

<Layout
  title={t.metaTitle}
  description={t.metaDescription}
  path="/en/dates"
  lang={lang}
  alternates={{ de: "/de/termine", en: "/en/dates" }}
>
  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-5xl px-4 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-3xl font-bold text-neutral-900 lg:text-4xl">{t.heading}</h1>
        <p class="mt-4 text-neutral-600">{t.intro}</p>

        <h2 class="mt-12 text-2xl font-bold text-neutral-900">{t.arrivalHeading}</h2>
        <p class="mt-4 text-neutral-600">{t.arrivalIntro}</p>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-neutral-600 marker:text-red-500">
          {
            t.tours.map((tour) => (
              <li>
                <strong class="font-semibold text-neutral-900">{tour.title}</strong> {tour.text}
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-neutral-600">{t.transfer}</p>
      </div>

      <div class="mt-12">
        <TourDatesTable lang={lang} />
      </div>

      <div class="mt-14 max-w-3xl">
        <h2 class="text-2xl font-bold text-neutral-900">{t.seasonHeading}</h2>
        <p class="mt-4 text-neutral-600">{t.seasonText}</p>

        <h2 class="mt-12 text-2xl font-bold text-neutral-900">{t.groupHeading}</h2>
        <p class="mt-4 text-neutral-600">{t.groupText}</p>

        <CtaButtons primary={t.cta} class="mt-10" />
      </div>
    </div>
  </section>
</Layout>
