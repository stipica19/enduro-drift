---
import Layout from "@/layouts/Layout.astro";
import EquipmentDetails from "@/components/ui/EquipmentDetails.astro";
import { motorcycles } from "@/content/site/motorcycles";

const lang = "en" as const;
const t = motorcycles[lang];
---

<Layout
  title={t.equipmentMetaTitle}
  description={t.equipmentMetaDescription}
  path="/en/equipment"
  lang={lang}
  alternates={{ de: "/de/ausruestung", en: "/en/equipment" }}
>
  <EquipmentDetails lang={lang} />
</Layout>
