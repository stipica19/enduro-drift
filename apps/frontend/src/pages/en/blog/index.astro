---
import Layout from "@/layouts/Layout.astro";
import { blogPath, getPosts, slugOf } from "@/lib/blog";

const posts = await getPosts("en");

function formatDate(date: Date) {
  return date.toLocaleDateString("en-GB", { day: "2-digit", month: "long", year: "numeric" });
}
---

<Layout
  title="Enduro Blog: Tips & Tour Stories | Enduro Drift Bosnien"
  description="News, tour stories and tips about enduro tours in Bosnia: gear, best time to travel, season dates and more."
  path="/en/blog"
  lang="en"
  alternates={{ de: "/de/blog", en: "/en/blog" }}
>
  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-5xl px-4 lg:px-8">
      <h1 class="text-3xl font-bold text-neutral-900 lg:text-4xl">Blog</h1>
      <p class="mt-4 text-neutral-600">News and stories from our tours.</p>

      {posts.length === 0 ? (
        <p class="mt-10 rounded-xl bg-neutral-100 p-6 text-center text-neutral-600">
          No blog posts yet.
        </p>
      ) : (
        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
          {posts.map((post) => (
            <a
              href={blogPath("en", slugOf(post))}
              class="group overflow-hidden rounded-2xl bg-neutral-50 ring-1 ring-neutral-100 transition-shadow hover:shadow-md"
            >
              {post.data.cover && (
                <img
                  src={post.data.cover}
                  alt={post.data.title}
                  loading="lazy"
                  class="aspect-video w-full object-cover"
                />
              )}
              <div class="p-5">
                <p class="text-xs text-neutral-500">{formatDate(post.data.date)}</p>
                <h2 class="mt-2 text-lg font-bold text-neutral-900 group-hover:text-red-600">
                  {post.data.title}
                </h2>
                <p class="mt-2 text-sm text-neutral-600">{post.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
