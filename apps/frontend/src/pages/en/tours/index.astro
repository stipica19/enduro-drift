---
import Layout from "@/layouts/Layout.astro";
import TourPricingSection from "@/components/ui/TourPricingSection.astro";
import TourComparison from "@/components/ui/TourComparison.astro";
import FaqSection from "@/components/ui/FaqSection.astro";
import { faqSchema, touristTripSchemas } from "@/lib/structuredData";
import { getToursPage } from "@/lib/tours";

const page = getToursPage("en");
---

<Layout
  title={page.metaTitle}
  description={page.metaDescription}
  path="/en/tours"
  lang="en"
  alternates={{ de: "/de/touren", en: "/en/tours" }}
  schema={[...touristTripSchemas("en"), faqSchema(page.faq)]}
>
  <TourPricingSection lang="en" />
  <TourComparison lang="en" tours={page.tours} labels={page.comparison} />
  <FaqSection lang="en" items={page.faq} heading={page.faqHeading} headingAccent={page.faqHeadingAccent} />
</Layout>
