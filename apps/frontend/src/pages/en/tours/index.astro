---
import Layout from "@/layouts/Layout.astro";
import TourPricingSection from "@/components/ui/TourPricingSection.astro";
import { touristTripSchemas } from "@/lib/structuredData";
---

<Layout
  title="Enduro Tours & Prices | Enduro Drift Bosnien"
  description="All our guided enduro tours in Bosnia at a glance - prices, what's included, and dates for beginners through experienced riders."
  path="/en/tours"
  lang="en"
  alternates={{ de: "/de/touren", en: "/en/tours" }}
  schema={touristTripSchemas("en")}
>
  <TourPricingSection lang="en" asPageHeading />
</Layout>
