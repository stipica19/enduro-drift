---
import Layout from "@/layouts/Layout.astro";
import TourPricingSection from "@/components/ui/TourPricingSection.astro";
import { touristTripSchemas } from "@/lib/structuredData";
---

<Layout
  title="Enduro Touren & Preise | Enduro Drift Bosnien"
  description="Alle geführten Enduro-Touren in Bosnien im Überblick - Preise, Leistungen und Termine für Einsteiger bis erfahrene Fahrer."
  path="/de/touren"
  lang="de"
  alternates={{ de: "/de/touren", en: "/en/tours" }}
  schema={touristTripSchemas("de")}
>
  <TourPricingSection lang="de" asPageHeading />
</Layout>
