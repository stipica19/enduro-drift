---
import TourDetail from "@/components/ui/TourDetail.astro";
import { tourIds, tourSlug } from "@/lib/tours";
import type { TourId } from "@/content/site/tourPricing";

// Slugovi su u src/content/tourSlugs.mjs (isti izvor kao sitemap).
export function getStaticPaths() {
  return tourIds.map((id) => ({ params: { slug: tourSlug("de", id) }, props: { id } }));
}

interface Props {
  id: TourId;
}

const { id } = Astro.props;
---

<TourDetail lang="de" id={id} />
