---
import Layout from "@/layouts/Layout.astro";
import { privacy } from "@/content/site/privacy";

const lang = "de" as const;
const t = privacy[lang];
---

<Layout
  title={t.metaTitle}
  description={t.metaDescription}
  path="/de/privacy"
  lang={lang}
  alternates={{ de: "/de/privacy", en: "/en/privacy" }}
>
  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-3xl px-4 lg:px-8">
      <h1 class="text-3xl font-bold text-neutral-900 lg:text-4xl">{t.heading}</h1>
      <p class="mt-4 text-neutral-600">{t.intro}</p>

      <div class="mt-10 space-y-10">
        {
          t.sections.map((section) => (
            <div>
              <h2 class="text-xl font-bold text-neutral-900">{section.heading}</h2>
              <div class="mt-3 space-y-3">
                {section.paragraphs.map((p) => (
                  <p class="leading-relaxed whitespace-pre-line text-neutral-600">{p}</p>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
