---
import Layout from "@/layouts/Layout.astro";
import { HardHat, Footprints, Hand, Shield } from "lucide-astro";
import { motorcycles } from "@/content/site/motorcycles";

const lang = "de" as const;
const t = motorcycles[lang];
const equipmentIcons = [HardHat, Footprints, Hand, Shield];
---

<Layout
  title={t.equipmentMetaTitle}
  description={t.equipmentMetaDescription}
  path="/de/ausruestung"
  lang={lang}
  alternates={{ de: "/de/ausruestung", en: "/en/equipment" }}
>
  <section class="bg-neutral-950 py-16 text-neutral-100 lg:py-24">
    <div class="mx-auto max-w-3xl px-4 text-center lg:px-8">
      <h1 class="text-3xl font-bold lg:text-4xl">
        {t.equipmentHeading}
        <span class="text-red-500">{t.equipmentAccent}</span>
      </h1>
      <p class="mt-4 text-neutral-400">{t.equipmentIntro}</p>
      <span
        class="mt-4 inline-flex items-center gap-2 rounded-full border border-red-500/40 bg-red-500/10 px-4 py-1.5 text-sm font-semibold text-red-400"
      >
        {t.freeBadge}
      </span>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-4xl px-4 lg:px-8">
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          t.equipmentItems.map((label, i) => {
            const Icon = equipmentIcons[i];
            return (
              <li class="flex items-center gap-3 rounded-xl bg-neutral-50 p-4 ring-1 ring-neutral-100">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-500">
                  <Icon class="h-5 w-5" />
                </span>
                <span class="min-w-0 flex-1 wrap-break-words text-sm font-medium text-neutral-900">
                  {label}
                </span>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</Layout>
