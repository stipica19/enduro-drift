---
import Layout from "@/layouts/Layout.astro";
import TourCta from "@/components/ui/TourCta.astro";
import { gallery } from "@/content/site/gallery";
import { SERVER_API_URL } from "@/lib/serverApi";

interface GalleryImage {
  url: string;
  publicId: string | null;
}

const lang = "de" as const;
const t = gallery[lang];

const res = await fetch(`${SERVER_API_URL}/api/gallery`);
// Bez ovoga bi API greška u buildu tiho objavila praznu stranicu (tanak sadržaj u indeksu) umjesto da deploy padne.
if (!res.ok) throw new Error(`GET /api/gallery -> ${res.status}`);
const images: GalleryImage[] = await res.json();
---

<Layout
  title={t.metaTitle}
  description={t.metaDescription}
  path="/de/galerie"
  lang={lang}
  alternates={{ de: "/de/galerie", en: "/en/gallery" }}
>
  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 lg:px-8">
      <h1 class="text-3xl font-bold text-neutral-900 lg:text-4xl">
        {t.heading}
      </h1>
      <p class="mt-4 text-neutral-600">{t.intro}</p>

      {
        images.length === 0 ? (
          <p class="mt-10 rounded-xl bg-neutral-100 p-6 text-center text-neutral-600">
            {t.empty}
          </p>
        ) : (
          <div class="mt-10 columns-1 gap-4 sm:columns-2 lg:columns-4">
            {images.map((img, i) => (
              <img
                src={img.url}
                alt={`${t.altPrefix} ${i + 1}`}
                loading={i < 8 ? "eager" : "lazy"}
                class="mb-4 w-full break-inside-avoid rounded-xl bg-neutral-100 object-cover"
              />
            ))}
          </div>
        )
      }

      <TourCta lang={lang} class="mt-12" />
    </div>
  </section>
</Layout>
