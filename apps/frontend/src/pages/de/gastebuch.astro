---
import Layout from "@/layouts/Layout.astro";
import { Quote } from "lucide-astro";
import { guestbook } from "@/content/site/guestbook";

interface Review {
  name: string;
  city: string | null;
  text: string;
  date: string;
}

const lang = "de" as const;
const t = guestbook[lang];

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:3001";
const res = await fetch(`${API_URL}/api/reviews`);
const reviews: Review[] = res.ok ? await res.json() : [];

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString(t.locale, {
    month: "long",
    year: "numeric",
  });
}
---

<Layout
  title={t.metaTitle}
  description={t.metaDescription}
  path="/de/gastebuch"
  lang={lang}
  alternates={{ de: "/de/gastebuch", en: "/en/guestbook" }}
>
  <section class="bg-neutral-950 py-16 text-neutral-100 lg:py-24">
    <div class="mx-auto max-w-3xl px-4 text-center lg:px-8">
      <h1 class="text-3xl font-bold lg:text-4xl">{t.heading}</h1>
      <p class="mt-4 text-neutral-400">{t.intro}</p>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-6xl px-4 lg:px-8">
      {
        reviews.length === 0 ? (
          <p class="rounded-xl bg-neutral-100 p-6 text-center text-neutral-600">
            {t.empty}
          </p>
        ) : (
          <div class="columns-1 gap-6 lg:columns-2">
            {reviews.map((review) => (
              <div class="mb-6 break-inside-avoid rounded-2xl bg-neutral-50 p-8 ring-1 ring-neutral-100">
                <Quote class="h-6 w-6 text-red-500" />
                <p class="mt-4 leading-relaxed whitespace-pre-line text-neutral-700">
                  {review.text}
                </p>
                <div class="mt-6 border-t border-neutral-200 pt-4">
                  <p class="font-bold text-neutral-900">
                    {review.name}
                    {review.city && (
                      <span class="font-normal text-neutral-500">
                        {" "}
                        — {review.city}
                      </span>
                    )}
                  </p>
                  <p class="mt-1 text-xs text-neutral-400">
                    {formatDate(review.date)}
                  </p>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Layout>
