---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import TourDatesTable from "@/components/ui/TourDatesTable.astro";
import BookingForm from "@/components/islands/BookingForm";
import { Info } from "lucide-astro";
import coverImage from "@/assets/hero-bild.webp";
import { booking } from "@/content/site/booking";
import { arrivalNotice } from "@/content/site/arrivalNotice";

const lang = "de" as const;
const t = booking[lang];
const notice = arrivalNotice[lang];

const tours = ["Tour 1", "Tour 2", "Tour 3"];
const preselectedTour = Astro.url.searchParams.get("tour") ?? "";

interface TourDateApiItem {
  _id: string;
  number: number;
  startDate: string;
  endDate: string;
  available: boolean;
}

const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:3001";

const [tourDatesRes] = await Promise.all([fetch(`${API_URL}/api/tour-dates`)]);

const rawTourDates: TourDateApiItem[] = tourDatesRes.ok
  ? await tourDatesRes.json()
  : [];

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString(t.locale, {
    day: "2-digit",
    month: "2-digit",
    year: "2-digit",
  });
}

const tourDates = rawTourDates
  .filter((d) => d.available)
  .map((d) => ({
    id: d._id,
    label: `${t.dateOptionPrefix} ${d.number}: ${formatDate(d.startDate)} - ${formatDate(d.endDate)}`,
  }));
---

<Layout
  title={t.metaTitle}
  description={t.metaDescription}
  path="/de/anmeldung"
  lang={lang}
  alternates={{ de: "/de/anmeldung", en: "/en/booking" }}
>
  <section class="relative overflow-hidden bg-neutral-950 text-neutral-100">
    <Image
      src={coverImage}
      alt="Enduro Tour in Bosnien"
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-linear-to-b from-neutral-950/85 via-neutral-950/75 to-neutral-950"
    >
    </div>

    <div
      class="relative z-10 mx-auto max-w-5xl px-4 py-16 text-center lg:px-8 lg:py-24"
    >
      <h1 class="text-3xl font-bold lg:text-4xl">
        {t.heading} <span class="text-red-500">{t.headingAccent}</span>
      </h1>

      <ol class="mt-8 space-y-4 text-left text-neutral-300">
        {
          t.steps.map((step, i) => (
            <li class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-red-600 text-xs font-bold text-white">
                {i + 1}
              </span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-white py-10">
    <div class="mx-auto max-w-5xl px-4 lg:px-8">
      <div
        class="flex items-start gap-3 rounded-xl border border-sky-200 bg-sky-50 p-5"
      >
        <Info class="mt-0.5 h-5 w-5 shrink-0 text-sky-600" />
        <div class="text-sm text-neutral-700">
          <p class="font-semibold text-neutral-900">
            {notice.title}
          </p>
          <p class="mt-1">
            {notice.intro}
          </p>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            {notice.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white pb-16 lg:pb-24">
    <div class="mx-auto max-w-5xl px-4 lg:px-8">
      <TourDatesTable lang={lang} />
    </div>
  </section>

  <section class="bg-neutral-50 py-16 lg:py-24">
    <div class="mx-auto max-w-5xl px-4 lg:px-8">
      <h2 class="text-2xl font-bold text-neutral-900 lg:text-3xl">{t.sectionHeading}</h2>
      <div class="mt-8 bg-white p-0 lg:p-10">
        <BookingForm
          client:load
          lang={lang}
          tours={tours}
          tourDates={tourDates}
          initialTour={preselectedTour}
        />
      </div>
    </div>
  </section>
</Layout>
