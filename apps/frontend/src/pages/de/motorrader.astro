---
import Layout from "@/layouts/Layout.astro";
import FleetDetails from "@/components/ui/FleetDetails.astro";
import { motorcycles } from "@/content/site/motorcycles";

const lang = "de" as const;
const t = motorcycles[lang];
---

<Layout
  title={t.metaTitle}
  description={t.metaDescription}
  path="/de/motorrader"
  lang={lang}
  alternates={{ de: "/de/motorrader", en: "/en/motorcycles" }}
>
  <FleetDetails lang={lang} />
</Layout>
