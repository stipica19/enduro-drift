---
import BlogArticle from "@/components/ui/BlogArticle.astro";
import { getPosts, slugOf } from "@/lib/blog";
import type { BlogPost } from "@/lib/blog";

export async function getStaticPaths() {
  const posts = await getPosts("de");

  return posts.map((post) => ({
    params: { slug: slugOf(post) },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<BlogArticle lang="de" post={post} />
