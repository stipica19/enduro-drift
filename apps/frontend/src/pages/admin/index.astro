---
import Layout from "@/layouts/Layout.astro";
import AdminBookingsList from "../../components/islands/AdminBookingsList";
---

<Layout
  title="Admin — Prijave"
  description="Admin panel - lista prijava."
  path="/admin"
  noindex
>
  <div class="mx-auto max-w-5xl px-4 py-10 lg:px-8">
    <AdminBookingsList client:load />
  </div>
</Layout>
<style is:global>
  @media print {
    @page {
      size: A4;
      margin: 15mm;
    }
    body > header,
    body > footer {
      display: none !important;
    }
    body {
      background: #fff !important;
    }
    main > div {
      padding: 0 !important;
      max-width: none !important;
    }
  }
</style>
