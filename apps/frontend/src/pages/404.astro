---
import Layout from "@/layouts/Layout.astro";

// nginx ne zna jezik posjetitelja, pa je 404 dvojezična. Ostaje noindex; status 404 vraća nginx (error_page).
const blocks = [
  {
    lang: "de",
    heading: "Seite nicht gefunden",
    text: "Diese Seite gibt es nicht (mehr). Hier geht es weiter:",
    links: [
      { href: "/de/", label: "Startseite" },
      { href: "/de/touren/", label: "Touren & Preise" },
      { href: "/de/kontakt/", label: "Kontakt" },
    ],
  },
  {
    lang: "en",
    heading: "Page not found",
    text: "This page doesn't exist (any more). Here's where to go next:",
    links: [
      { href: "/en/", label: "Home" },
      { href: "/en/tours/", label: "Tours & prices" },
      { href: "/en/contact/", label: "Contact" },
    ],
  },
];
---

<Layout
  title="Seite nicht gefunden | Enduro Drift Bosnien"
  description="Diese Seite gibt es nicht. / This page does not exist."
  path="/404"
  noindex
>
  <section class="bg-neutral-950 py-24 text-neutral-100 lg:py-32">
    <div class="mx-auto max-w-3xl px-4 text-center lg:px-8">
      <p class="text-sm font-semibold tracking-widest text-red-500 uppercase">404</p>
      {
        blocks.map((block, i) => {
          const Heading = i === 0 ? "h1" : "h2";
          return (
            <div lang={block.lang} class={i === 0 ? "mt-4" : "mt-14 border-t border-white/10 pt-14"}>
              <Heading class="text-3xl font-bold lg:text-4xl">{block.heading}</Heading>
              <p class="mt-4 text-neutral-400">{block.text}</p>
              <div class="mt-6 flex flex-wrap justify-center gap-3">
                {block.links.map((link, j) => (
                  <a
                    href={link.href}
                    class={
                      j === 0
                        ? "inline-flex min-h-12 items-center rounded-xl bg-red-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-red-700"
                        : "inline-flex min-h-12 items-center rounded-xl border border-white/30 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-white/60"
                    }
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </section>
</Layout>
