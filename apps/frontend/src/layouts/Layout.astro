---
import { getImage } from "astro:assets";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";
import WhatsappWidget from "../components/ui/WhatsappWidget.astro";
import defaultOgSource from "../assets/hero-bild.webp";
import { siteUrl } from "../lib/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "de" | "en";
  path: string;
  alternates?: { de?: string; en?: string };
  noindex?: boolean;
  image?: ImageMetadata;
  ogType?: "website" | "article";
  /** ISO datum objave, ide u article:published_time (samo za ogType="article"). */
  publishedTime?: string;
}

const {
  title,
  description,
  lang = "de",
  path,
  alternates,
  noindex = false,
  image = defaultOgSource,
  ogType = "website",
  publishedTime,
} = Astro.props;

// Stranice se serviraju kao /de/kontakt/ (folder + index.html), a nginx /de/kontakt preusmjerava
// na /de/kontakt/. Canonical, og:url i hreflang moraju pokazivati na URL sa kosom crtom (isti kao
// u sitemapu), inače canonical pokazuje na URL koji sam radi redirect pa ga Google može ignorirati.
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const canonicalPath = withSlash(path);
const pageAlternates = alternates && {
  de: alternates.de && withSlash(alternates.de),
  en: alternates.en && withSlash(alternates.en),
};

const ogImage = await getImage({
  src: image,
  width: 1200,
  height: 630,
  format: "jpg",
});
const ogImageUrl = `${siteUrl}${ogImage.src}`;
const ogLocale = lang === "de" ? "de_DE" : "en_US";
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="144x144" href="/logo.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={`${siteUrl}${canonicalPath}`} />
    {
      pageAlternates?.de && (
        <link
          rel="alternate"
          hreflang="de"
          href={`${siteUrl}${pageAlternates.de}`}
        />
      )
    }
    {
      pageAlternates?.en && (
        <link
          rel="alternate"
          hreflang="en"
          href={`${siteUrl}${pageAlternates.en}`}
        />
      )
    }
    {
      pageAlternates?.de && pageAlternates?.en && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={`${siteUrl}${pageAlternates.de}`}
        />
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Enduro Drift Bosnien" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${siteUrl}${canonicalPath}`} />
    <meta property="og:locale" content={ogLocale} />
    {pageAlternates?.de && pageAlternates?.en && (
      <meta property="og:locale:alternate" content={lang === "de" ? "en_US" : "de_DE"} />
    )}
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <slot name="head" />
  </head>
  <body class="bg-neutral-100 text-neutral-100">
    <Header lang={lang} alternates={pageAlternates} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    {!noindex && <WhatsappWidget lang={lang} />}
  </body>
</html>
