---
import { tourDatesTable } from "@/content/site/tourDatesTable";
import { SERVER_API_URL } from "@/lib/serverApi";
import { formatShortDate, type TourDateItem } from "@/lib/tourDates";

interface Props {
  lang?: "de" | "en";
}

const { lang = "de" } = Astro.props;
const t = tourDatesTable[lang];

const res = await fetch(`${SERVER_API_URL}/api/tour-dates`);
const tourDates: TourDateItem[] = res.ok ? await res.json() : [];

const bySeason = tourDates.reduce<Record<string, TourDateItem[]>>((acc, td) => {
  (acc[td.season] ??= []).push(td);
  return acc;
}, {});

const seasons = Object.keys(bySeason).sort();

function formatDate(iso: string) {
  return formatShortDate(iso, t.locale);
}
---

<div
  data-tour-dates
  data-available-label={t.available}
  data-unavailable-label={t.unavailable}
>
{
  seasons.length === 0 && (
    <p class="rounded-xl bg-neutral-100 p-6 text-center text-neutral-600">
      {t.empty}
    </p>
  )
}

{
  seasons.map((season) => (
    <div class="mb-10 last:mb-0">
      <h3 class="mb-4 text-xl font-bold text-neutral-900">
        <span class="text-red-500">{season}</span> {t.reserveSuffix}
      </h3>
      <div class="overflow-x-auto rounded-xl ring-1 ring-neutral-200">
        <table class="w-full text-left text-sm">
          <thead class="bg-neutral-900 text-white">
            <tr>
              <th class="px-2 py-3 font-semibold">{t.tourNumber}</th>
              <th class="px-2 py-3 font-semibold">{t.from}</th>
              <th class="px-2 py-3 font-semibold">{t.to}</th>
              <th class="px-4 py-3 font-semibold">{t.availability}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100 bg-white">
            {bySeason[season].map((td) => (
              <tr>
                <td class="px-2 py-3 font-medium text-neutral-900">
                  {td.number}
                </td>
                <td class="px-2 py-3 text-neutral-600">
                  {formatDate(td.startDate)}
                </td>
                <td class="px-2 py-3 text-neutral-600">
                  {formatDate(td.endDate)}
                </td>
                <td class="px-2 py-3">
                  <span
                    data-tour-date-id={td._id}
                    class={`rounded-full px-3 py-1 text-xs font-semibold ${
                      td.available
                        ? "bg-green-100 text-green-700"
                        : "bg-red-100 text-red-700"
                    }`}
                  >
                    {td.available ? t.available : t.unavailable}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ))
}
</div>

<script>
  import { fetchTourDates } from "../../lib/tourDates";

  // Stranica je statična: "Verfügbar/Nicht verfügbar" iz builda zastarije čim se netko
  // prijavi. Pri učitavanju se stanje osvježi iz API-ja; ako API ne odgovori, ostaje ono
  // iz builda. Novi termini (redovi) i dalje traže rebuild — ovdje se mijenjaju samo oznake.
  const roots = document.querySelectorAll<HTMLElement>("[data-tour-dates]");

  if (roots.length > 0) {
    fetchTourDates().then((list) => {
      if (!list) return;

      const availableById = new Map(list.map((d) => [d._id, d.available]));

      roots.forEach((root) => {
        root.querySelectorAll<HTMLElement>("[data-tour-date-id]").forEach((badge) => {
          const available = availableById.get(badge.dataset.tourDateId ?? "");
          if (available === undefined) return;

          badge.textContent = available
            ? (root.dataset.availableLabel ?? badge.textContent)
            : (root.dataset.unavailableLabel ?? badge.textContent);
          badge.classList.toggle("bg-green-100", available);
          badge.classList.toggle("text-green-700", available);
          badge.classList.toggle("bg-red-100", !available);
          badge.classList.toggle("text-red-700", !available);
        });
      });
    });
  }
</script>
