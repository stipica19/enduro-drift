---
import { tourDatesTable } from "@/content/site/tourDatesTable";
import { SERVER_API_URL } from "@/lib/serverApi";

interface Props {
  lang?: "de" | "en";
}

interface TourDate {
  _id: string;
  number: number;
  season: string;
  startDate: string;
  endDate: string;
  available: boolean;
}

const { lang = "de" } = Astro.props;
const t = tourDatesTable[lang];

const res = await fetch(`${SERVER_API_URL}/api/tour-dates`);
const tourDates: TourDate[] = res.ok ? await res.json() : [];

const bySeason = tourDates.reduce<Record<string, TourDate[]>>((acc, td) => {
  (acc[td.season] ??= []).push(td);
  return acc;
}, {});

const seasons = Object.keys(bySeason).sort();

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString(t.locale, { day: "2-digit", month: "2-digit", year: "2-digit" });
}
---

{
  seasons.length === 0 && (
    <p class="rounded-xl bg-neutral-100 p-6 text-center text-neutral-600">
      {t.empty}
    </p>
  )
}

{
  seasons.map((season) => (
    <div class="mb-10 last:mb-0">
      <h3 class="mb-4 text-xl font-bold text-neutral-900">
        <span class="text-red-500">{season}</span> {t.reserveSuffix}
      </h3>
      <div class="overflow-x-auto rounded-xl ring-1 ring-neutral-200">
        <table class="w-full text-left text-sm">
          <thead class="bg-neutral-900 text-white">
            <tr>
              <th class="px-4 py-3 font-semibold">{t.tourNumber}</th>
              <th class="px-4 py-3 font-semibold">{t.from}</th>
              <th class="px-4 py-3 font-semibold">{t.to}</th>
              <th class="px-4 py-3 font-semibold">{t.availability}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100 bg-white">
            {bySeason[season].map((td) => (
              <tr>
                <td class="px-4 py-3 font-medium text-neutral-900">{td.number}</td>
                <td class="px-4 py-3 text-neutral-600">{formatDate(td.startDate)}</td>
                <td class="px-4 py-3 text-neutral-600">{formatDate(td.endDate)}</td>
                <td class="px-4 py-3">
                  <span
                    class={`rounded-full px-3 py-1 text-xs font-semibold ${
                      td.available ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700"
                    }`}
                  >
                    {td.available ? t.available : t.unavailable}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ))
}
