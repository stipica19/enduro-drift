---
import { siWhatsapp } from "simple-icons/icons";
import { whatsappWidget } from "@/content/site/whatsappWidget";

interface Props {
  lang?: "de" | "en";
}

const { lang = "de" } = Astro.props;
const content = whatsappWidget[lang];

const href = `https://wa.me/38763136095?text=${encodeURIComponent(content.message)}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={content.ariaLabel}
  class="fixed right-5 bottom-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-transform hover:scale-110"
>
  <svg viewBox="0 0 24 24" class="h-7 w-7 fill-current">
    <path d={siWhatsapp.path}></path>
  </svg>
</a>
