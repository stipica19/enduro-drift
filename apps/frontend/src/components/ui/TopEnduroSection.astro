---
import { getImage } from "astro:assets";
import { Globe, Check, Play } from "lucide-astro";
import videoSrc from "@/assets/video/enduro-video.mp4";
import posterSrc from "@/assets/video/enduro-poster.webp";
import { topEnduro } from "@/content/site/topEnduro";

interface Props {
  lang?: "de" | "en";
}

const { lang = "de" } = Astro.props;
const content = topEnduro[lang];
const highlights = content.highlights;

// Kartica je max 384 px široka (max-w-sm), pa 576 px pokriva i retinu 1.5x
const poster = await getImage({ src: posterSrc, width: 576, format: "webp", quality: 70 });
---

<section class="bg-white text-neutral-900">
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 px-4 py-16 lg:grid-cols-2 lg:gap-16 lg:px-8 lg:py-24"
  >
    <div>
      <div class="flex items-center gap-2">
        <Globe class="h-7 w-7 text-red-600" />
        <h2 class="text-2xl font-bold tracking-tight lg:text-3xl">
          {content.heading}
        </h2>
      </div>
      <p class="mt-2 text-sm text-neutral-500">
        {content.subheading}
      </p>

      <p class="mt-6 text-neutral-700">
        {content.intro}
      </p>

      <ul class="mt-6 space-y-3">
        {
          highlights.map((item) => (
            <li class="flex items-start gap-3 text-neutral-800">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-600">
                <Check class="h-3.5 w-3.5" strokeWidth={3} />
              </span>
              {item}
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href={content.pricesCta.href}
          class="rounded border border-neutral-300 px-6 py-3 text-sm font-semibold uppercase tracking-wide text-neutral-900 transition-colors hover:border-red-500 hover:text-red-600"
        >
          {content.pricesCta.label}
        </a>
        <a
          href={content.bookCta.href}
          class="rounded bg-red-600 px-6 py-3 text-sm font-semibold uppercase tracking-wide text-white transition-colors hover:bg-red-500"
        >
          {content.bookCta.label}
        </a>
      </div>
    </div>

    <div
      class="relative mx-auto aspect-3/4 w-full max-w-sm overflow-hidden rounded-2xl bg-neutral-200"
    >
      <!-- preload="none": MP4 (~2.8 MB) se ne dotiče dok gost ne pritisne play. Sa "metadata"
           je Chrome povlačio cijeli fajl pri učitavanju stranice i gušio LCP hero slike. -->
      <video
        id="top-enduro-video"
        src={videoSrc}
        poster={poster.src}
        class="h-full w-full object-cover"
        playsinline
        preload="none"></video>
      <button
        id="top-enduro-play"
        class="absolute inset-0 flex items-center justify-center"
        aria-label="Video abspielen"
      >
        <span
          class="flex h-14 w-14 items-center justify-center rounded-full bg-white/90 text-neutral-900 shadow-lg"
        >
          <Play class="h-6 w-6 translate-x-0.5" fill="currentColor" />
        </span>
      </button>
    </div>

    <script>
      const video = document.getElementById(
        "top-enduro-video",
      ) as HTMLVideoElement | null;
      const playButton = document.getElementById("top-enduro-play");

      playButton?.addEventListener("click", () => {
        video?.play();
        video?.setAttribute("controls", "true");
        if (playButton) playButton.style.display = "none";
      });
    </script>
  </div>
</section>
