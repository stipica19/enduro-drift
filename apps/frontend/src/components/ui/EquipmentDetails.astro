---
import { HardHat, Footprints, Hand, Shield, ShieldCheck } from "lucide-astro";
import CtaButtons from "@/components/ui/CtaButtons.astro";
import { equipmentPage } from "@/content/site/equipmentPage";

interface Props {
  lang: "de" | "en";
}

const { lang } = Astro.props;
const p = equipmentPage[lang];
const icons = [HardHat, Footprints, Hand, Shield, ShieldCheck];
---

<section class="bg-neutral-950 py-16 text-neutral-100 lg:py-24">
  <div class="mx-auto max-w-3xl px-4 text-center lg:px-8">
    <h1 class="text-3xl font-bold lg:text-4xl">
      {p.heading} <span class="text-red-500">{p.headingAccent}</span>
    </h1>
    <p class="mt-4 text-neutral-400">{p.intro}</p>
  </div>
</section>

<section class="bg-white py-16 lg:py-24">
  <div class="mx-auto max-w-4xl px-4 lg:px-8">
    <h2 class="text-2xl font-bold text-neutral-900">{p.includedHeading}</h2>
    <ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        p.included.map((item, i) => {
          const Icon = icons[i];
          return (
            <li class="flex items-start gap-3 rounded-xl bg-neutral-50 p-4 ring-1 ring-neutral-100">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-500">
                <Icon class="h-5 w-5" />
              </span>
              <span class="min-w-0 flex-1 text-sm">
                <span class="block font-semibold text-neutral-900">{item.title}</span>
                {item.text && <span class="mt-0.5 block text-neutral-600">{item.text}</span>}
              </span>
            </li>
          );
        })
      }
    </ul>
    <p class="mt-6 text-neutral-600">{p.sizesNote}</p>

    <h2 class="mt-14 text-2xl font-bold text-neutral-900">{p.bringHeading}</h2>
    <ul class="mt-6 list-disc space-y-3 pl-5 text-neutral-600 marker:text-red-500">
      {
        p.bring.map((item) => (
          <li>
            <strong class="font-semibold text-neutral-900">{item.title}</strong> {item.text}
          </li>
        ))
      }
    </ul>

    <h2 class="mt-14 text-2xl font-bold text-neutral-900">{p.ownHeading}</h2>
    <p class="mt-4 text-neutral-600">{p.ownText}</p>

    <p class="mt-8 text-neutral-600">
      {p.guideText}{" "}
      <a href={p.guideLink.href} class="font-semibold text-red-600 hover:underline">
        {p.guideLink.label}
      </a>
    </p>

    <CtaButtons primary={p.ctaPrimary} secondary={p.ctaSecondary} class="mt-10" />
  </div>
</section>
