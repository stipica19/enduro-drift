---
import { Image } from "astro:assets";
import { Gauge, HardHat, Footprints, Hand, Shield } from "lucide-astro";
import { motorcycles } from "@/content/site/motorcycles";

interface Props {
  lang?: "de" | "en";
}

const { lang = "de" } = Astro.props;
const content = motorcycles[lang];
const equipmentIcons = [HardHat, Footprints, Hand, Shield];

// TODO: dodaj fotografije motora u src/assets/motorrader/
const images = Object.values(
  import.meta.glob<{ default: ImageMetadata }>(
    "../../assets/motorrader/*.{jpg,jpeg,png,webp}",
    { eager: true },
  ),
).map((mod) => mod.default);
---

<section class="bg-neutral-50 py-16 lg:py-24">
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 items-start gap-10 px-4 lg:grid-cols-2 lg:gap-16 lg:px-8"
  >
    <div>
      <h2 class="text-3xl font-bold text-neutral-900 lg:text-4xl">
        {content.heading} <span class="text-red-500">{content.headingAccent}</span>
      </h2>
      <p class="mt-5 text-neutral-600">
        {content.intro}
      </p>
      <span
        class="mt-4 inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-4 py-1.5 text-sm font-semibold text-red-600"
      >
        {content.readyToRace}
      </span>

      <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {
          content.bikes.map((bike) => (
            <li class="flex items-center gap-3 rounded-xl bg-white px-4 py-3 shadow-sm ring-1 ring-neutral-100">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-red-50 text-red-500">
                <Gauge class="h-4 w-4" />
              </span>
              <span class="text-sm font-semibold text-neutral-900">{bike}</span>
            </li>
          ))
        }
      </ul>

      <h3 class="mt-10 text-2xl font-bold text-neutral-900">
        <span class="text-red-500">{content.equipmentAccent}</span>
      </h3>
      <p class="mt-4 text-neutral-600">
        {content.equipmentIntro}
      </p>

      <ul class="mt-6 grid grid-cols-2 gap-4">
        {
          content.equipmentItems.map((label, i) => {
            const Icon = equipmentIcons[i];
            return (
              <li class="flex items-center gap-3 rounded-xl bg-white p-4 ring-1 ring-neutral-100">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-500">
                  <Icon class="h-5 w-5" />
                </span>
                <span class="text-sm font-medium text-neutral-900">{label}</span>
              </li>
            );
          })
        }
      </ul>

      <span
        class="mt-6 inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50 px-4 py-1.5 text-sm font-semibold text-red-600"
      >
        {content.freeBadge}
      </span>
    </div>

    <div class="grid grid-cols-1 gap-4 lg:sticky lg:top-24 lg:grid-cols-2">
      {
        images.map((img, i) => (
          <div class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-neutral-100">
            <Image
              src={img}
              alt={content.bikes[i] ?? "Enduro"}
              class="aspect-3/2 w-full object-cover transition-transform duration-300 hover:scale-105"
              loading="lazy"
              widths={[300, 500]}
              sizes="(min-width: 1024px) 300px, 45vw"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
