---
import { Image } from "astro:assets";
import { ArrowRight, Bike, Flame, Zap } from "lucide-astro";
import { tourTeaser } from "@/content/site/tourTeaser";
import { tourCardLabels } from "@/content/site/tourCard";
import { tourPricing } from "@/content/site/tourPricing";
import { getTour, tourIds } from "@/lib/tours";

interface Props {
  lang?: "de" | "en";
}

// Homepage: samo pregled tura s linkom na detalj-stranicu. Pune kartice s cijenama su na /touren
// (TourPricingSection) — ne vraćati ih ovdje, inače homepage i /touren opet imaju isti sadržaj.
const { lang = "de" } = Astro.props;
const content = tourTeaser[lang];
const pricing = tourPricing[lang];
const tours = tourIds.map((id) => getTour(lang, id));
---

<section class="bg-neutral-950 py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 text-center lg:px-8">
    <span
      class="inline-flex items-center gap-2 rounded-full border border-red-500/30 bg-red-600/10 px-4 py-1.5 text-sm font-medium text-red-400"
    >
      <Bike class="h-4 w-4" /> {content.badge}
    </span>
    <h2 class="mt-6 text-3xl font-bold text-white lg:text-4xl">
      {content.heading} <span class="text-red-500">{content.headingAccent}</span>
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-neutral-400">{content.subheading}</p>
  </div>

  <ul class="mx-auto mt-12 grid max-w-7xl grid-cols-1 gap-6 px-4 md:grid-cols-3 lg:px-8">
    {
      tours.map(({ card, detail, image, path, meta }) => {
        const TerrainIcon = detail.terrain === "hard" ? Flame : Zap;
        const terrain = detail.terrain === "hard" ? pricing.hardEnduro : pricing.mediumEnduro;
        return (
          <li>
            <a
              href={path}
              class="group flex h-full flex-col overflow-hidden rounded-2xl bg-neutral-900 ring-1 ring-neutral-800 transition-colors hover:ring-red-500/60 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
            >
              <div class="relative h-44">
                <Image
                  src={image}
                  alt={card.imageAlt}
                  class="h-full w-full object-cover"
                  loading="lazy"
                  widths={[400, 800]}
                  sizes="(min-width: 768px) 400px, 90vw"
                />
                {card.badge && (
                  <span class="absolute top-3 right-3 rounded-full bg-red-600 px-3 py-1 text-xs font-bold tracking-wide text-white uppercase">
                    {card.badge}
                  </span>
                )}
              </div>
              <div class="flex flex-1 flex-col p-5">
                <span class="flex items-center gap-2 text-sm text-red-400">
                  <TerrainIcon class="h-4 w-4" /> {detail.level} · {terrain.title}
                </span>
                <h3 class="mt-2 text-xl font-bold text-white group-hover:text-red-400">{detail.name}</h3>
                <p class="mt-1 text-neutral-400">{meta}</p>
                <span class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-semibold text-white">
                  {tourCardLabels[lang].details.replace("{name}", detail.name)}
                  <ArrowRight class="h-4 w-4 transition-transform motion-safe:group-hover:translate-x-1" />
                </span>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>

  <div class="mx-auto mt-10 flex max-w-7xl flex-col justify-center gap-3 px-4 sm:flex-row lg:px-8">
    <a
      href={content.allToursCta.href}
      class="inline-flex min-h-12 items-center justify-center rounded-xl bg-red-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
    >
      {content.allToursCta.label}
    </a>
    <a
      href={content.bookCta.href}
      class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white/30 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-white/60 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
    >
      {content.bookCta.label}
    </a>
  </div>
</section>
