---
import { Image } from "astro:assets";
import { ArrowRight, Check, Star } from "lucide-astro";
import hero from "../../assets/hero-bild.webp";
import { hero as heroContent } from "@/content/site/hero";

interface Props {
  lang?: "de" | "en";
  reviewsSummary?: { average: number; count: number } | null;
}

const { lang = "de", reviewsSummary = null } = Astro.props;
const content = heroContent[lang];
const highlights = content.highlights;
---

<section
  aria-labelledby="hero-title"
  class="relative isolate overflow-hidden bg-neutral-950 text-white"
>
  <Image
    src={hero}
    alt="Enduro Fahrer im Gelände in Bosnien"
    class="absolute inset-0 -z-30 h-full w-full object-cover object-center"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Dunkler Bereich hinter dem Text, mehr Bild auf der rechten Seite -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-20 bg-neutral-950/45 lg:bg-transparent lg:bg-linear-to-r lg:from-neutral-950/95 lg:via-neutral-950/65 lg:to-neutral-950/15"
  >
  </div>

  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-linear-to-t from-neutral-950 via-neutral-950/15 to-neutral-950/20"
  >
  </div>

  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="pb-12 pt-16 sm:pt-20 lg:pb-16 lg:pt-28">
      <div class="max-w-3xl">
        <a
          href={content.badgeHref}
          class="inline-flex items-center gap-3 rounded-full border border-white/20 bg-neutral-950/40 px-4 py-2 text-xs font-medium text-white backdrop-blur-sm transition-colors hover:bg-neutral-950/60 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white sm:text-sm"
        >
          <span class="h-2 w-2 shrink-0 rounded-full bg-red-500"></span>
          {content.badge}
          <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </a>

        <h1
          id="hero-title"
          class="mt-7 text-5xl font-bold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl xl:text-8xl"
        >
          {content.titleLine1}
          <br />
          {content.titleLine2}
          <span class="mt-2 block text-red-500">{content.titleAccent}</span>
        </h1>

        <p
          class="mt-6 max-w-xl text-base leading-relaxed text-white sm:text-lg"
        >
          {content.description}
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={content.primaryCta.href}
            class="group inline-flex min-h-14 items-center justify-center gap-3 rounded-xl bg-red-600 px-6 py-4 text-sm font-semibold text-white transition-colors hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
          >
            {content.primaryCta.label}
            <ArrowRight
              class="h-4 w-4 transition-transform motion-safe:group-hover:translate-x-1"
              aria-hidden="true"
            />
          </a>

          <a
            href={content.secondaryCta.href}
            class="inline-flex min-h-14 items-center justify-center rounded-xl border border-white/30 bg-neutral-950/30 px-6 py-4 text-sm font-semibold text-white backdrop-blur-sm transition-colors hover:border-white/60 hover:bg-neutral-950/50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
          >
            {content.secondaryCta.label}
          </a>
        </div>

        <!--   {
          reviewsSummary && reviewsSummary.count > 0 && (
            <div class="mt-7 flex items-center gap-2 text-base text-white">
              <Star
                class="h-4 w-4 shrink-0 fill-amber-400 text-amber-400"
                aria-hidden="true"
              />
              <p>
                <span class="font-semibold text-white">
                  {reviewsSummary.average.toLocaleString(
                    lang === "en" ? "en-GB" : "de-DE",
                    { minimumFractionDigits: 1, maximumFractionDigits: 1 },
                  )}
                </span>
                <span class="mx-2 text-neutral-400" aria-hidden="true">
                  ·
                </span>
                {reviewsSummary.count}{" "}
                {reviewsSummary.count === 1
                  ? content.reviewsSingular
                  : content.reviewsPlural}
              </p>
            </div>
          )
        } -->
      </div>

      <div class="mt-12 border-t border-white/15 pt-6 lg:mt-20">
        <ul class="flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:gap-x-8">
          {
            highlights.map((highlight) => (
              <li class="flex items-center gap-3 text-base text-white">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-red-500/15">
                  <Check
                    class="h-3.5 w-3.5 text-red-400"
                    strokeWidth={2.5}
                    aria-hidden="true"
                  />
                </span>
                {highlight}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
