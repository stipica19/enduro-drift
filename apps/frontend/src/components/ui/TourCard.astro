---
import { Image } from "astro:assets";
import { Check, Info, X } from "lucide-astro";
import { tourCardLabels } from "@/content/site/tourCard";

interface Props {
  lang?: "de" | "en";
  title: string;
  badge?: string;
  image: ImageMetadata;
  ownBikePrice: number;
  rentalBikePrice: number;
  included: string[];
  additionalCosts: string[];
  excluded: string[];
  arrival: string;
  departure: string;
  ctaHref: string;
}

const {
  lang = "de",
  title,
  badge,
  image,
  ownBikePrice,
  rentalBikePrice,
  included,
  additionalCosts,
  excluded,
  arrival,
  departure,
  ctaHref,
} = Astro.props;

const labels = tourCardLabels[lang];
---

<div
  class="flex h-full flex-col overflow-hidden rounded-2xl bg-neutral-900 ring-1 ring-neutral-800"
>
  <div class="relative h-48 w-full">
    <Image
      src={image}
      alt=""
      class="h-full w-full object-cover"
      loading="lazy"
      widths={[400, 800]}
      sizes="(min-width: 1024px) 400px, 90vw"
    />
    {
      badge && (
        <span class="absolute top-3 right-3 rounded-full bg-red-600 px-3 py-1 text-xs font-bold tracking-wide text-white uppercase">
          {badge}
        </span>
      )
    }
    <div
      class="absolute inset-x-0 bottom-0 bg-linear-to-t from-neutral-950/90 to-transparent p-4"
    >
      <h3 class="text-lg font-bold text-white">{title}</h3>
    </div>
  </div>

  <div class="flex flex-1 flex-col p-4 text-neutral-200">
    <div
      class="flex items-center justify-between border-b border-neutral-800 pb-3"
    >
      <span class="text-base text-neutral-400">{labels.ownBike}</span>
      <span class="text-lg font-bold text-white">{ownBikePrice} €</span>
    </div>
    <div
      class="flex items-center justify-between border-b border-neutral-800 py-3"
    >
      <span class="text-base text-neutral-400">{labels.rentalBike}</span>
      <span class="text-lg font-bold text-red-500">{rentalBikePrice} €</span>
    </div>

    <div class="mt-4">
      <p class="flex items-center gap-2 text-base font-semibold text-white">
        <Check class="h-4 w-4 text-green-500" strokeWidth={3} /> {labels.included}
      </p>
      <ul class="mt-2 space-y-1.5">
        {
          included.map((item) => (
            <li class="ml-4 flex items-start gap-2 text-base text-neutral-300">
              <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-green-500" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-4">
      <p class="flex items-center gap-2 text-base font-semibold text-white">
        <Info class="h-4 w-4 text-sky-400" /> {labels.additionalCosts}
      </p>
      <ul class="mt-2 space-y-1.5">
        {
          additionalCosts.map((item) => (
            <li class="ml-4 flex items-start gap-2 text-base text-neutral-300">
              <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-sky-400" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-4">
      <p class="flex items-center gap-2 text-base font-semibold text-white">
        <X class="h-4 w-4 text-red-500" strokeWidth={3} /> {labels.excluded}
      </p>
      <ul class="mt-2 space-y-1.5">
        {
          excluded.map((item) => (
            <li class="ml-4 flex items-start gap-2 text-base text-neutral-300">
              <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-red-500" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-4 space-y-1 text-base text-neutral-400">
      <p>{labels.arrival}: {arrival}</p>
      <p>{labels.departure}: {departure}</p>
    </div>

    <a
      href={ctaHref}
      class="mt-6 block rounded bg-red-600 py-3 text-center text-base font-semibold tracking-wide text-white uppercase transition-colors hover:bg-red-500"
    >
      {labels.cta}
    </a>
  </div>
</div>
