---
import TourCard from "@/components/ui/TourCard.astro";
import { Bike, Flame, Zap } from "lucide-astro";
import { tourPricing } from "@/content/site/tourPricing";

// TODO: zamijeni sa stvarnim fotografijama/mapama tura kad budu spremne
import mapBeginner from "@/assets/tours/tura1-map.webp";
import mapIntermediate from "@/assets/tours/tura2-map.webp";
import advancedPhoto from "@/assets/tours/tura22-map.webp";

interface Props {
  lang?: "de" | "en";
}

const { lang = "de" } = Astro.props;
const content = tourPricing[lang];
const images = [mapBeginner, mapIntermediate, advancedPhoto];
---

<section class="bg-neutral-950 py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 text-center lg:px-8">
    <span
      class="inline-flex items-center gap-2 rounded-full border border-red-500/30 bg-red-600/10 px-4 py-1.5 text-sm font-medium text-red-400"
    >
      <Bike class="h-4 w-4" /> {content.badge}
    </span>
    <h2 class="mt-6 text-3xl font-bold text-white lg:text-4xl">
      {content.heading} <span class="text-red-500">{content.headingAccent}</span>
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-neutral-400">
      {content.subheading}
    </p>
  </div>

  <div class="mx-auto mt-12 grid max-w-7xl grid-cols-1 gap-6 px-4 lg:grid-cols-3 lg:px-8">
    {content.cards.map((card, i) => (
      <TourCard
        lang={lang}
        title={card.title}
        badge={card.badge}
        image={images[i]}
        ownBikePrice={card.ownBikePrice}
        rentalBikePrice={card.rentalBikePrice}
        included={card.included}
        additionalCosts={content.additionalCosts}
        excluded={content.excluded}
        arrival={card.arrival}
        departure={card.departure}
        ctaHref={card.ctaHref}
      />
    ))}
  </div>

  <div class="mx-auto mt-12 grid max-w-7xl grid-cols-1 gap-4 px-4 sm:grid-cols-2 lg:px-8">
    <div class="rounded-2xl bg-red-950/40 p-6 ring-1 ring-red-900/50">
      <div class="flex items-center gap-3">
        <span
          class="flex h-10 w-10 items-center justify-center rounded-lg bg-red-600/20 text-red-500"
        >
          <Flame class="h-5 w-5" />
        </span>
        <h3 class="text-lg font-bold text-white">{content.hardEnduro.title}</h3>
      </div>
      <p class="mt-3 text-sm text-neutral-300">
        {content.hardEnduro.text}
      </p>
    </div>

    <div class="rounded-2xl bg-amber-950/40 p-6 ring-1 ring-amber-900/50">
      <div class="flex items-center gap-3">
        <span
          class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-500/20 text-amber-400"
        >
          <Zap class="h-5 w-5" />
        </span>
        <h3 class="text-lg font-bold text-white">{content.mediumEnduro.title}</h3>
      </div>
      <p class="mt-3 text-sm text-neutral-300">
        {content.mediumEnduro.text}
      </p>
    </div>
  </div>

  <div class="mx-auto mt-10 max-w-7xl px-4 text-center lg:px-8">
    <p class="text-neutral-400">
      {content.helpText}
    </p>
    <a
      href={content.helpCta.href}
      class="mt-4 inline-block rounded-full border border-neutral-700 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-red-500 hover:text-red-400"
    >
      {content.helpCta.label}
    </a>
  </div>
</section>
