---
import { Image } from "astro:assets";
import { MapPin, Mountain } from "lucide-astro";
import bild from "@/assets/mapa.webp";
import { location } from "@/content/site/location";

interface Props {
  lang?: "de" | "en";
}

const { lang = "de" } = Astro.props;
const content = location[lang];
---

<section class="bg-slate-50 py-16 lg:py-24">
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 px-4 lg:grid-cols-2 lg:gap-16 lg:px-8"
  >
    <div>
      <h2 class="text-3xl font-bold tracking-tight text-neutral-900 lg:text-4xl">
        {content.heading} <span class="text-red-500">{content.headingAccent}</span>
      </h2>
      <p class="mt-5 text-neutral-600">
        {content.intro}
      </p>

      <ul class="mt-6 space-y-3">
        {content.highlights.map((item) => (
          <li class="flex items-center gap-3 text-neutral-700">
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-red-500" />
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-lg rounded-2xl bg-neutral-300 p-3 shadow-xl">
      <Image
        src={bild}
        alt={content.pinLabel}
        class="aspect-4/3 w-full rounded-xl object-cover"
      />

      <span
        class="absolute -top-3 right-4 flex items-center gap-1.5 rounded-full bg-red-600 px-3 py-1.5 text-sm font-semibold text-white shadow-lg"
      >
        <MapPin class="h-4 w-4" /> {content.pinLabel}
      </span>

      <span
        class="absolute bottom-6 left-6 flex items-center gap-1.5 rounded-full bg-blue-600 px-3 py-1 text-xs font-semibold text-white shadow-lg"
      >
        <Mountain class="h-3.5 w-3.5" /> {content.elevationLabel}
      </span>

      <div
        class="absolute right-6 bottom-6 space-y-1 rounded-lg bg-neutral-900/85 px-3 py-2 text-xs text-white shadow-lg"
      >
        {content.distances.map((d) => (
          <p class="flex justify-between gap-4">
            <span>{d.city}</span>
            <span class="font-semibold">{d.km} km</span>
          </p>
        ))}
      </div>
    </div>
  </div>
</section>
