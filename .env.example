# Kopiraj u .env i popuni stvarnim vrijednostima.
# .env je u .gitignore i NIKAD ne ide u git ni u Docker image.
#
# Na VPS-u ovaj fajl stoji pored compose.yml — backend kontejner ga čita
# preko "env_file: .env".

# --- Docker image-i (koristi compose.yml) ---
# GitHub korisnicko ime / organizacija pod kojom su image-i na GHCR-u
GHCR_OWNER=tvoj-github-username
# Koji tag se pokrece. "latest" prati zadnji deploy; za rollback upisi konkretan SHA tag.
IMAGE_TAG=latest

# --- Backend: server ---
PORT=3001
NODE_ENV=production
# Origin s kojeg dolaze zahtjevi iz browsera — mora biti tacna javna domena zbog CORS-a i cookiea
# (trenutno: testna domena; kod pravog produkcijskog deploya promijeni na endurodriftbosnien.com)
FRONTEND_ORIGIN=https://dev.skin-glow.beauty

# --- Baza (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=endurodrift
# Stara baza — treba samo lokalno, za migracione skripte. Na produkciji ostavi prazno.
OLD_MONGODB_DB_NAME=

# --- Admin sesija ---
# Dugacak nasumican string. Generisi sa: openssl rand -base64 32
SESSION_SECRET=
# Koriste samo scripts/seedAdmin.ts pri kreiranju admin naloga
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email (Resend) ---
RESEND_API_KEY=
CONTACT_EMAIL_TO=endurodriftbosnien@gmail.com
# Dok domena nije verifikovana u Resendu, koristi onboarding@resend.dev
CONTACT_EMAIL_FROM=onboarding@resend.dev

# --- reCAPTCHA v3 ---
# Secret key je tajna i koristi ga SAMO backend
RECAPTCHA_SECRET_KEY=
# Site key je javan (zavrsi u klijentskom JS-u). U CI-ju se prosljedjuje kao build-arg
# frontend image-u, vidi .github/workflows/deploy.yml
RECAPTCHA_SITE_KEY=
